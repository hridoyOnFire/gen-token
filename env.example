# ── Circle Developer-Controlled Wallets ──────────────────────────────────────
# Get your API key at: https://console.circle.com
CIRCLE_DEVELOPER_CONTROLLED_API_KEY=your_api_key_here

# 32-byte hex entity secret — register once at:
# https://developers.circle.com/wallets/dev-controlled/register-entity-secret
CIRCLE_ENTITY_SECRET=your_entity_secret_here
